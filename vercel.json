{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "cropdoc-backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": "pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && pip install -r requirements.txt"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "cropdoc-backend",
          "format": "url",
          "env": "BACKEND_SERVICE_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "cropdoc-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
