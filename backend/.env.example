# OpenWeatherMap API Key for hyper-local agricultural weather forecasts and disease risk calculation
# Obtain a free key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# Optional Google Gemini API Key for contextual dynamic agronomic advisory
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=

# Model Hardware Device: 'auto', 'cuda', 'mps', or 'cpu'
DEVICE=auto

# Minimum confidence threshold (0.0 to 1.0) for affirmative diagnosis
CONFIDENCE_THRESHOLD=0.35

# Custom trained weights path (optional)
# MODEL_WEIGHTS_PATH=./models/cropdoc_mobilenetv2.pth
